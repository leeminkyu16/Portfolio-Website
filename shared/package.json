{
  "name": "portfolio-website-shared",
  "version": "0.1.0",
  "description": "Shared resources for the portfolio website",
  "private": true,
  "scripts": {
    "build": "tsc",
    "lint-code-eslint": "eslint \"**/*.{js,jsx,ts,tsx,json,md}\" --fix",
    "lint": "npm run lint-code-eslint",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest"
  },
  "author": "Min-Kyu Lee",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-markdown": "^5.1.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "jest": "^30.4.2",
    "prettier": "^3.9.4",
    "prettier-plugin-organize-imports": "^4.3.0",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1"
  },
  "jest": {
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.spec.json"
        }
      ]
    },
    "testRegex": "(/test/.+\\.spec)\\.tsx?$",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "json",
      "node"
    ]
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "/dist"
  ]
}
