{
  "name": "portfolio-website-frontend",
  "private": true,
  "description": "A simple portfolio website",
  "version": "0.1.0",
  "scripts": {
    "build": "gatsby build",
    "develop": "gatsby develop",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "start": "gatsby develop",
    "start-network": "gatsby develop -H 0.0.0.0",
    "serve": "gatsby serve",
    "clean": "gatsby clean",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint-code-eslint": "eslint \"src/**/*.{js,jsx,ts,tsx,json,md}\" --fix",
    "lint-code-prettier": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "lint-style": "stylelint \"src/**/*.scss\" --fix",
    "lint": "npm run lint-code-eslint && npm run lint-code-prettier && npm run lint-style",
    "link": "npm link ../shared"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "@tweenjs/tween.js": "^25.0.0",
    "gatsby": "^5.16.1",
    "gatsby-plugin-manifest": "^5.16.0",
    "gatsby-plugin-react-helmet": "^6.16.0",
    "gatsby-plugin-sass": "^6.16.0",
    "portfolio-website-shared": "../shared",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet": "^6.1.0",
    "react-redux": "^9.3.0",
    "redux": "^5.0.1",
    "sanitize-html": "^2.17.5",
    "sass": "^1.101.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/jest": "^30.0.0",
    "@types/loadable__component": "^5.13.10",
    "@types/node": "^26.1.0",
    "@types/react": "^18.0.33",
    "@types/react-dom": "^18.0.11",
    "@types/react-helmet": "^6.1.11",
    "@types/sanitize-html": "^2.16.1",
    "@types/three": "^0.185.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-markdown": "^5.1.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "prettier": "^3.9.4",
    "prettier-plugin-organize-imports": "^4.3.0",
    "stylelint": "^17.14.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-prettier": "^5.0.3",
    "stylelint-scss": "^7.2.0",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1"
  },
  "jest": {
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    },
    "testRegex": "(/src/.+\\.spec)\\.tsx?$",
    "testEnvironment": "jsdom",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "json",
      "node"
    ],
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|svg)$": "<rootDir>/mocks/fileMock.js",
      "\\.(s?css|sass)$": "<rootDir>/mocks/styleMock.js",
      "^three$": "<rootDir>/mocks/fileMock.js",
      "^@tweenjs/tween.js$": "<rootDir>/mocks/fileMock.js",
      "^portfolio-website-shared$": "<rootDir>/../shared/src/index.ts"
    },
    "globals": {
      "ts-jest": {
        "tsconfig": {
          "jsx": "react"
        }
      }
    }
  },
  "bugs": {
    "url": "https://github.com/gatsbyjs/gatsby/issues"
  }
}
